// KYC application schema. Owned by the KYC app session.

enum KycStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

model KycCase {
  id               String     @id @default(cuid())
  caseNumber       Int        @unique @default(autoincrement())
  reference        String     @unique
  // Where the case came from ("seed", "manual", or a connector id) and its id in that system.
  source           String     @default("manual")
  sourceId         String?
  applicantName    String
  applicantCountry String
  riskScore        Int
  status           KycStatus  @default(NEW)
  assigneeId       String?
  // Set when a case is escalated so the four-eyes guard can stop the escalator
  // from claiming it back.
  lastEscalatedById String?
  submittedAt      DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        KycDocument[]

  @@index([status])
  @@index([assigneeId])
  @@index([riskScore])
  @@unique([source, sourceId])
}

// Admin-editable field mapping from a connector record onto KycCase columns.
model SourceMapping {
  id          String   @id @default(cuid())
  source      String
  sourceField String
  targetField String
  updatedAt   DateTime @updatedAt

  @@unique([source, targetField])
}

model KycDocument {
  id       String  @id @default(cuid())
  caseId   String
  type     String
  filename String
  verified Boolean @default(false)
  case     KycCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}
